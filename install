#!/bin/bash
set -euo pipefail

echo "Installing OpenGora..."
echo ""

if command -v npm &>/dev/null; then
  echo "Installing opengora-ai via npm..."
  npm install -g opengora-ai
  echo ""
  echo "Installed OpenGora successfully!"
  echo "Run 'opengora --help' to get started."
else
  echo "npm is required. Install Node.js from https://nodejs.org then re-run this script."
  exit 1
fi
